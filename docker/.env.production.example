ASTER_BROKER_IMAGE=aster-brokerd:0.8
ASTER_CELL_IMAGE=aster-v8cell:0.8
ASTER_DB_URL_FILE=/absolute/path/to/.aster/db_url
ASTER_SEAL_KEY_FILE=/absolute/path/to/.aster/seal.key
ASTER_LAUNCH_KEY_FILE=/absolute/path/to/.aster/launch.key
ASTER_POLICY_FILE=/absolute/path/to/.aster/policy.json
ASTER_MODULES_DIR=/absolute/path/to/convex-storage/modules
ASTER_RUNTIME_DIR=/absolute/path/to/.aster/run
ASTER_RUNTIME_UID=1000
ASTER_RUNTIME_GID=1000
ASTER_DATABASE_NETWORK=convex-database
ASTER_DB_SCHEMA=convex_dev
ASTER_TENANT=tenant-name
ASTER_DEPLOYMENT=deployment-name
ASTER_MODULE_PATH=messages.js
ASTER_FUNCTION_NAME=getById
ASTER_ARGS_JSON=[]
ASTER_MAX_TRAPS=4096
ASTER_MAX_HEAP_BYTES=134217728
ASTER_EXECUTION_TIMEOUT_MS=25000
ASTER_INVOCATION_TIMEOUT_SECONDS=30
ASTER_MAX_RETRIES=3
